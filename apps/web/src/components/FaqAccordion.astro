---
import RichText from './RichText.astro'
import type { FaqEntry } from '../lib/shapes'

interface Props {
  entries: FaqEntry[]
}
const { entries } = Astro.props
---

<!-- Native details/summary: opens by click, Enter or Space, and announces expanded/collapsed. -->
<div class="flex flex-col gap-0.5">
  {entries.map((entry) => (
    <details class="group bg-surface">
      <summary class="flex cursor-pointer items-center justify-between gap-4 px-4 py-3.5 font-black lg:px-5">
        {entry.question}
        <span class="text-esn-blue group-open:rotate-45" aria-hidden="true">
          +
        </span>
      </summary>
      <RichText value={entry.answer} class="px-4 pb-4 text-base leading-relaxed lg:px-5" />
    </details>
  ))}
</div>
