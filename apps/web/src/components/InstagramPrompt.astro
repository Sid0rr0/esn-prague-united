---
interface Props {
  instagram?: string | null
  class?: string
}

const { instagram, class: className } = Astro.props
---

<!-- Shown where upcoming Events would be when there are none yet. -->
<div class:list={['flex flex-col gap-3 p-4 lg:self-start lg:p-6', className]}>
  <p class="text-base leading-normal">
    We announce new trips, parties and meetups on Instagram first.
  </p>
  {instagram && (
    <a
      href={instagram}
      rel="noopener"
      class="flex h-12 items-center justify-center bg-esn-blue px-5 font-black text-white hover:brightness-92 lg:self-start"
    >
      Follow us on Instagram
    </a>
  )}
</div>
