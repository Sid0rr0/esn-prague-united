---
import type { Stat } from '../lib/types'

interface Props {
  stats: Stat[]
}
const { stats } = Astro.props
---

{stats.length > 0 && (
  <dl class="grid grid-cols-2 gap-0.5 border-2 border-line bg-line lg:grid-cols-4">
    {stats.map((stat) => (
      <div class="flex flex-col-reverse gap-0.5 bg-white p-4 lg:gap-1 lg:px-5 lg:py-5.5">
        <dt class="text-[13px] font-bold text-muted lg:text-sm">{stat.label}</dt>
        <dd class="font-heading text-[34px] leading-none font-bold text-esn-blue lg:text-[44px]">
          {stat.value}
        </dd>
      </div>
    ))}
  </dl>
)}
