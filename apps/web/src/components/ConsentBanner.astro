---
import { uiString } from '../lib/ui-strings'

// Accept and Reject share one style so neither is the easier choice.
const buttonClass =
  'flex h-12 flex-1 items-center justify-center border-2 border-esn-blue px-5 font-black text-esn-blue hover:bg-blue-50 lg:flex-none'
---

<!-- Hidden in the server HTML; the consent module shows it while the visitor is undecided
     and when they open Cookie settings. -->
<section
  data-consent-banner
  hidden
  aria-labelledby="consent-heading"
  class="fixed inset-x-0 bottom-0 z-50 flex flex-col gap-4 border-t-4 border-esn-blue bg-white px-5 py-5 lg:flex-row lg:items-center lg:justify-between lg:px-14"
>
  <div class="flex max-w-200 flex-col gap-1">
    <h2 id="consent-heading" class="font-heading text-lg font-bold text-esn-blue">
      {uiString('consentHeading')}
    </h2>
    <p class="text-base leading-normal">
      {uiString('consentText')}{' '}
      <a href="/privacy-policy" class="font-bold text-esn-blue underline">
        {uiString('privacyPolicy')}
      </a>
    </p>
  </div>
  <div class="flex gap-2">
    <button type="button" data-consent-accept class={buttonClass}>
      {uiString('consentAccept')}
    </button>
    <button type="button" data-consent-reject class={buttonClass}>
      {uiString('consentReject')}
    </button>
  </div>
</section>

<script>
  import { startConsent } from '../lib/consent'

  startConsent(document, () => window.localStorage)
</script>
