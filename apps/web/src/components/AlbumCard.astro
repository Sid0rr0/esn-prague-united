---
import Picture from './Picture.astro'
import { formatDayMonthYear, formatPhotoCount } from '../lib/format'
import type { AlbumSummary } from '../lib/types'

interface Props {
  album: AlbumSummary
}

const { album } = Astro.props
---

<a data-album-card href={`/gallery/${album.slug}`} class="group flex h-full flex-col bg-surface">
  <Picture image={album.cover} width={400} height={300} class="aspect-4/3 w-full" />
  <div class="flex flex-col gap-1 px-4 py-3.5 lg:px-5 lg:py-4">
    <span class="text-base font-black group-hover:text-esn-blue lg:text-[17px]">{album.title}</span>
    <span class="text-[15px] text-muted">
      <time datetime={album.date}>{formatDayMonthYear(album.date)}</time> ·{' '}
      {formatPhotoCount(album.photoCount)}
    </span>
  </div>
</a>
