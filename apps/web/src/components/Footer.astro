---
import { SITE_NAME } from '../lib/site'

interface Props {
  text?: string
}
const { text } = Astro.props
---

<footer class="flex flex-col gap-3.5 bg-esn-blue px-5 py-7 text-white lg:flex-row lg:items-center lg:justify-between lg:px-14 lg:py-8">
  <div class="flex items-center gap-3">
    <span class="font-heading text-lg font-bold">{SITE_NAME}</span>
    {text && <p class="text-sm text-on-blue-muted">{text}</p>}
  </div>
</footer>
