---
import SocialLinks from './SocialLinks.astro'
import { SITE_NAME } from '../lib/site'
import type { Socials } from '../lib/types'

interface Props {
  socials?: Socials | null
  text?: string
}
const { socials, text } = Astro.props
---

<footer class="flex flex-col gap-3.5 bg-ink px-5 py-7 text-white lg:flex-row lg:items-center lg:justify-between lg:px-14 lg:py-8">
  <div class="flex flex-col gap-2">
    <div class="flex items-center gap-3">
      <img src="/esn-star.png" alt="" class="size-7 lg:size-8" />
      <span class="font-heading text-lg font-bold">{SITE_NAME}</span>
    </div>
    {text && <p class="text-sm text-on-blue-muted">{text}</p>}
  </div>
  <SocialLinks socials={socials} variant="compact" />
</footer>
