---
import { externalLinkProps } from '../lib/external-link'
import type { Socials } from '../lib/shapes'

interface Props {
  /** GROQ returns null for social links that were never filled in. */
  socials?: Socials | null
}

const NETWORKS: { key: keyof Socials; name: string }[] = [
  { key: 'instagram', name: 'Instagram' },
  { key: 'facebook', name: 'Facebook' },
  { key: 'tiktok', name: 'TikTok' },
  { key: 'whatsapp', name: 'WhatsApp' },
  { key: 'linkedin', name: 'LinkedIn' },
  { key: 'website', name: 'Website' },
]

const socials = Astro.props.socials ?? {}
const links = NETWORKS.filter(({ key }) => socials[key]).map((network) => ({
  ...network,
  url: socials[network.key] as string,
}))
---

{links.length > 0 && (
  <ul class="grid grid-cols-3 gap-0.5">
    {links.map(({ name, url }) => (
      <li>
        <a
          href={url}
          {...externalLinkProps(url)}
          class="flex h-12 items-center justify-center bg-white/12 text-sm font-black text-white hover:bg-white/25"
        >
          {name}
        </a>
      </li>
    ))}
  </ul>
)}
