---
import EventCard from './EventCard.astro'
import type { EventCardData } from '../lib/shapes'

interface Props {
  events: EventCardData[]
  /** Columns on desktop. */
  columns?: 3 | 4
}
const { events, columns = 4 } = Astro.props
---

<ul
  class:list={['grid gap-0.5 md:grid-cols-2', columns === 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-4']}
>
  {events.map((event) => (
    <li>
      <EventCard event={event} />
    </li>
  ))}
</ul>
