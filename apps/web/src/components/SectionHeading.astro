---
interface Props {
  /** Brand colour of the band this heading opens. */
  colour: string
}
const { colour } = Astro.props
---

<div class="flex flex-col gap-2.5 lg:gap-3">
  <span
    class="block h-1.5 w-10 lg:h-2 lg:w-12"
    style={`background: ${colour}`}
    aria-hidden="true"
  ></span>
  <h2 class="font-heading text-[30px] leading-none font-bold lg:text-[40px]">
    <slot />
  </h2>
</div>
