---
import { externalLinkProps } from '../lib/external-link'
import RichText from './RichText.astro'
import { formatPrice } from '../lib/format'
import { uiString } from '../lib/ui-strings'
import type { TicketsAside } from '../lib/ticket-area'

interface Props {
  aside: TicketsAside
}
const {
  aside: { ticketAction, tiers, info },
} = Astro.props
---

<aside
  data-ticket-sidebar
  aria-label="Tickets"
  class="flex flex-col gap-4 bg-surface p-5 lg:sticky lg:top-24 lg:gap-5 lg:p-7"
>
  <h2 class="font-heading text-2xl font-bold lg:text-[28px]">Tickets</h2>
  {tiers.length > 0 && (
    <ul class="flex flex-col divide-y divide-line">
      {tiers.map((tier) => (
        <li class="flex items-baseline justify-between gap-4 py-2.5">
          <span class="text-base">{tier.label}</span>
          <span class="font-black whitespace-nowrap text-esn-blue">{formatPrice(tier.amount)}</span>
        </li>
      ))}
    </ul>
  )}
  {/* On mobile the sticky bar carries the Buy button or Ticket note instead. */}
  {(ticketAction.kind === 'buy' || ticketAction.kind === 'choose-date') && (
    <a
      href={ticketAction.kind === 'buy' ? ticketAction.url : ticketAction.href}
      {...(ticketAction.kind === 'buy' ? externalLinkProps(ticketAction.url) : {})}
      class="flex h-14 items-center justify-center bg-esn-magenta px-6 text-[17px] font-black text-white hover:brightness-92 max-lg:hidden"
    >
      {ticketAction.kind === 'buy' ? 'Buy ticket' : uiString('chooseADate')}
    </a>
  )}
  {ticketAction.kind === 'note' && (
    <p
      data-ticket-note
      class="border-2 border-esn-blue px-4 py-3 text-center font-black max-lg:hidden"
    >
      {ticketAction.note}
    </p>
  )}
  <RichText value={info} class="text-[15px] leading-relaxed" />
</aside>
