---
import Layout from '../layouts/Layout.astro'
import PageHeader from '../components/PageHeader.astro'
import RichText from '../components/RichText.astro'
import { fetchContent } from '../lib/content'
import { PRIVACY_POLICY_QUERY } from '../lib/queries'
import type { PrivacyPolicy } from '../lib/types'
import { uiString } from '../lib/ui-strings'

const page = (await fetchContent<PrivacyPolicy | null>(PRIVACY_POLICY_QUERY)) ?? {}
const title = page.title ?? uiString('privacyPolicy')
---

<Layout title={title} seo={page.seo}>
  <PageHeader title={title} colour="orange" />

  <div class="px-5 py-8 lg:px-14 lg:py-14">
    <RichText value={page.body} class="max-w-200" />
  </div>
</Layout>
