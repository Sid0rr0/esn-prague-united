---
import Layout from '../../layouts/Layout.astro'
import EventGrid from '../../components/EventGrid.astro'
import PageHeader from '../../components/PageHeader.astro'
import SectionHeading from '../../components/SectionHeading.astro'
import { fetchContent } from '../../lib/content'
import { EVENTS_LIST_QUERY } from '../../lib/queries'
import type { EventsList } from '../../lib/types'

const { upcoming, past } = await fetchContent<EventsList>(EVENTS_LIST_QUERY)
---

<Layout title="Events">
  <PageHeader title="Events" colour="cyan">
    <p class="max-w-150 text-base leading-normal lg:text-lg">
      Trips, parties and special events created by ESN Prague United.
    </p>
  </PageHeader>

  <section data-upcoming class="flex flex-col gap-3.5 px-5 py-7 lg:gap-8 lg:p-14">
    <SectionHeading colour="var(--color-esn-cyan)">Upcoming</SectionHeading>
    {upcoming.length > 0 ? (
      <EventGrid events={upcoming} />
    ) : (
      <p class="text-base leading-normal">New events coming soon.</p>
    )}
  </section>

  {past.length > 0 && (
    <section data-past class="flex flex-col gap-3.5 px-5 pb-7 lg:gap-8 lg:px-14 lg:pb-14">
      <SectionHeading colour="var(--color-esn-cyan)">Past</SectionHeading>
      <EventGrid events={past} />
    </section>
  )}
</Layout>
