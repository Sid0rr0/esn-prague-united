---
import Layout from '../layouts/Layout.astro'
import { fetchContent } from '../lib/content'
import { LINKS_QUERY } from '../lib/queries'
import { SITE_NAME } from '../lib/site'
import type { LinksPage } from '../lib/types'

const page = (await fetchContent<LinksPage | null>(LINKS_QUERY)) ?? {}
const title = page.title ?? SITE_NAME
const links = page.links ?? []
const highlighted = links.filter((link) => link.highlight)
const plain = links.filter((link) => !link.highlight)
---

<!-- The link-in-bio page, inside the shared site header and footer. -->
<Layout title={title} seo={page.seo}>
  <div class="mx-auto flex w-full max-w-120 flex-col">
    <header class="flex flex-col items-center gap-3 bg-blue-50 px-5 pt-10 pb-8 text-center">
      <h1 class="font-heading text-[32px] leading-none font-bold">{title}</h1>
      {page.intro && <p class="text-base leading-normal whitespace-pre-line">{page.intro}</p>}
    </header>

    <div class="flex flex-1 flex-col gap-3 px-5 py-6">
      {highlighted.map((link) => (
        <a
          href={link.url}
          data-link="highlight"
          class="block bg-esn-magenta px-5 py-4 text-center text-lg font-black text-white hover:bg-esn-blue hover:text-white"
        >
          {link.label}
        </a>
      ))}
      {plain.length > 0 && (
        <ul class="flex flex-col gap-0.5">
          {plain.map((link) => (
            <li>
              <a
                href={link.url}
                data-link="plain"
                class="flex items-center justify-between bg-surface px-4 py-3.5 font-bold text-ink hover:text-esn-magenta"
              >
                {link.label}
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</Layout>
