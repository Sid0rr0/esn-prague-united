---
import Layout from '../layouts/Layout.astro'
import PageHeader from '../components/PageHeader.astro'
import SectionHeading from '../components/SectionHeading.astro'
import SocialLinks from '../components/SocialLinks.astro'
import { fetchContent } from '../lib/content'
import { CONTACTS_QUERY } from '../lib/queries'
import { sectionColours } from '../lib/section-colours'
import type { ContactsPage } from '../lib/types'

const page = (await fetchContent<ContactsPage | null>(CONTACTS_QUERY)) ?? {}
const title = page.title ?? 'Contact us'
const sections = (page.sections ?? []).map((section) => ({
  ...section,
  colour: sectionColours(section.slug).colour,
}))
const hasGeneralContact = Boolean(page.generalEmail || page.address)
const hasSocials = Object.values(page.socials ?? {}).some(Boolean)
---

<Layout title={title} seo={page.seo}>
  <PageHeader title={title} colour="orange">
    {page.intro && (
      <p class="max-w-150 text-base leading-normal whitespace-pre-line lg:text-lg">{page.intro}</p>
    )}
  </PageHeader>

  <div class="flex flex-col gap-10 px-5 py-8 lg:gap-14 lg:px-14 lg:py-14">
    {hasGeneralContact && (
      <section aria-labelledby="general-contact" class="flex max-w-200 flex-col gap-3">
        <h2
          id="general-contact"
          class="font-heading text-[26px] leading-none font-bold lg:text-[32px]"
        >
          ESN Prague United
        </h2>
        {page.generalEmail && (
          <a
            href={`mailto:${page.generalEmail}`}
            class="self-start text-lg font-black text-esn-blue hover:text-esn-magenta lg:text-xl"
          >
            {page.generalEmail}
          </a>
        )}
        {page.address && (
          <p class="text-base leading-relaxed whitespace-pre-line">{page.address}</p>
        )}
      </section>
    )}

    {sections.length > 0 && (
      <section aria-labelledby="section-contacts" class="flex max-w-200 flex-col gap-4">
        <SectionHeading colour="var(--color-esn-orange)">
          <span id="section-contacts">Sections</span>
        </SectionHeading>
        <ul class="flex flex-col gap-0.5">
          {sections.map((section) => (
            <li
              data-section-contact
              style={`border-color: ${section.colour}`}
              class="flex flex-col gap-1 border-l-6 bg-surface px-4 py-3.5 lg:flex-row lg:items-center lg:justify-between lg:px-5"
            >
              <span class="font-black">{section.name}</span>
              {section.email && (
                <a
                  href={`mailto:${section.email}`}
                  class="self-start font-bold text-esn-blue hover:text-esn-magenta lg:self-auto"
                >
                  {section.email}
                </a>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>

  {hasSocials && (
    <section
      aria-labelledby="follow-us"
      class="flex flex-col gap-4 bg-ink px-5 py-6 lg:px-14 lg:py-10"
    >
      <h2
        id="follow-us"
        class="font-heading text-[26px] leading-none font-bold text-white lg:text-[32px]"
      >
        Follow us
      </h2>
      <SocialLinks socials={page.socials} />
    </section>
  )}
</Layout>
