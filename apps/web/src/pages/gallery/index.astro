---
import Layout from '../../layouts/Layout.astro'
import AlbumCard from '../../components/AlbumCard.astro'
import { fetchContent } from '../../lib/content'
import { ALBUMS_QUERY } from '../../lib/queries'
import type { AlbumSummary } from '../../lib/types'

const albums = await fetchContent<AlbumSummary[]>(ALBUMS_QUERY)
---

<Layout title="Gallery">
  <section class="flex flex-col gap-3 bg-orange-50 px-5 py-7 lg:gap-4 lg:p-14">
    <span class="block h-1.5 w-10 bg-esn-orange lg:h-2 lg:w-12" aria-hidden="true"></span>
    <h1 class="font-heading text-[44px] leading-none font-bold lg:text-[64px]">Gallery</h1>
    <p class="max-w-150 text-base leading-normal lg:text-lg">
      Photos from our trips, parties and meetups.
    </p>
  </section>

  <ul class="grid gap-0.5 pt-0.5 pb-5 md:grid-cols-2 lg:grid-cols-4 lg:px-14 lg:pt-14 lg:pb-14">
    {albums.map((album) => (
      <li>
        <AlbumCard album={album} />
      </li>
    ))}
  </ul>
</Layout>
