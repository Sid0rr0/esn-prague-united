---
import Layout from '../layouts/Layout.astro'
import { fetchContent } from '../lib/content'
import { HOMEPAGE_QUERY } from '../lib/queries'
import { SITE_NAME } from '../lib/site'
import type { Homepage } from '../lib/types'

const { page } = await fetchContent<Homepage>(HOMEPAGE_QUERY)
---

<Layout seo={page?.seo}>
  <section class="bg-esn-blue px-5 pt-7 pb-8 text-white lg:px-14 lg:py-16">
    <h1 class="font-heading text-[42px] leading-[.98] font-bold lg:text-[64px]">
      {page?.hero?.heading ?? SITE_NAME}
    </h1>
    {page?.hero?.subheading && (
      <p class="mt-3.5 max-w-110 text-base lg:text-lg">{page.hero.subheading}</p>
    )}
  </section>
</Layout>
