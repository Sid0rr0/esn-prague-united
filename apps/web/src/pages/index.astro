---
import Layout from '../layouts/Layout.astro'
import HeroTicket from '../components/HeroTicket.astro'
import Picture from '../components/Picture.astro'
import RichText from '../components/RichText.astro'
import SectionHeading from '../components/SectionHeading.astro'
import StatGrid from '../components/StatGrid.astro'
import { fetchContent } from '../lib/content'
import { formatKicker, formatShortDate } from '../lib/format'
import { HOMEPAGE_QUERY } from '../lib/queries'
import { SITE_NAME } from '../lib/site'
import { ticketDisplay } from '../lib/tickets'
import type { Homepage } from '../lib/types'

const { page, upcoming, instagram } = await fetchContent<Homepage>(HOMEPAGE_QUERY)
const hero = page?.hero
const featured = page?.featuredEvent
const about = page?.about
const quickLinks = page?.quickLinks ?? []

// Empty while an Event is featured → hidden; empty otherwise → "New events coming soon".
const upcomingState = upcoming.length > 0 ? 'list' : featured ? 'hidden' : 'soon'
---

<Layout seo={page?.seo}>
  <section data-hero class="grid bg-esn-blue text-white lg:grid-cols-2">
    <Picture
      image={featured ? featured.heroImage : hero?.image}
      width={640}
      height={480}
      eager
      class="aspect-4/3 w-full lg:order-last lg:aspect-auto lg:h-full lg:min-h-135"
      fallbackClass="bg-esn-blue-shade"
    />
    <div class="flex flex-col justify-center gap-3.5 px-5 pt-7 pb-8 lg:gap-5.5 lg:px-14 lg:py-16">
      {featured ? (
        <>
          <p class="font-heading text-xl font-light lg:text-[26px]">
            {formatKicker(featured.startsAt)}
          </p>
          <h1 class="font-heading text-[60px] leading-[.9] font-bold lg:text-[96px]">
            <a href={`/events/${featured.slug}`} class="hover:text-on-blue-label">
              {featured.title}
            </a>
          </h1>
          {featured.summary && (
            <p class="max-w-110 text-base leading-normal lg:text-lg">{featured.summary}</p>
          )}
          <HeroTicket tickets={ticketDisplay(featured)} />
        </>
      ) : (
        <>
          <h1 class="font-heading text-[42px] leading-[.98] font-bold lg:text-[64px]">
            {hero?.heading ?? SITE_NAME}
          </h1>
          {hero?.subheading && (
            <p class="max-w-110 text-base leading-normal lg:text-lg">{hero.subheading}</p>
          )}
          <div class="flex flex-col gap-0.5 font-black lg:flex-row lg:self-start">
            {hero?.primaryButton?.url && (
              <a
                href={hero.primaryButton.url}
                class="flex h-14 items-center justify-center bg-white px-6 text-[17px] text-esn-blue hover:bg-blue-50"
              >
                {hero.primaryButton.label}
              </a>
            )}
            {hero?.secondaryButton?.url && (
              <a
                href={hero.secondaryButton.url}
                class="flex h-14 items-center justify-center border-2 border-white px-6 text-base hover:bg-white/12"
              >
                {hero.secondaryButton.label}
              </a>
            )}
          </div>
        </>
      )}
    </div>
  </section>

  {upcomingState !== 'hidden' && (
    <section
      data-upcoming
      class="grid gap-3.5 bg-cyan-50 px-5 py-7 lg:grid-cols-[280px_1fr] lg:gap-12 lg:p-14"
    >
      <SectionHeading colour="var(--color-esn-cyan)">
        {upcomingState === 'soon' ? 'New events coming soon' : 'Upcoming events'}
      </SectionHeading>
      {upcomingState === 'list' ? (
        <ul class="grid gap-0.5 lg:grid-cols-2">
          {upcoming.map((item) => (
            <li>
              <a
                href={`/events/${item.slug}`}
                class="flex h-full items-center gap-3.5 bg-white px-4 py-3.5 hover:bg-line lg:gap-4.5 lg:px-5.5 lg:py-5"
              >
                <time
                  datetime={item.startsAt}
                  class="w-15 shrink-0 font-heading text-base font-bold text-esn-blue lg:w-17.5 lg:text-lg"
                >
                  {formatShortDate(item.startsAt)}
                </time>
                <span class="text-base font-black lg:text-[17px]">{item.title}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="flex flex-col gap-3 bg-white p-4 lg:self-start lg:p-6">
          <p class="text-base leading-normal">
            We announce new trips, parties and meetups on Instagram first.
          </p>
          {instagram && (
            <a
              href={instagram}
              rel="noopener"
              class="flex h-12 items-center justify-center bg-esn-blue px-5 font-black text-white hover:brightness-92 lg:self-start"
            >
              Follow us on Instagram
            </a>
          )}
        </div>
      )}
    </section>
  )}

  {about && (
    <section class="grid gap-3.5 px-5 py-7 lg:grid-cols-[280px_1fr] lg:gap-12 lg:p-14">
      <SectionHeading colour="var(--color-esn-magenta)">
        {about.heading ?? `About ${SITE_NAME}`}
      </SectionHeading>
      <div class="flex flex-col gap-3.5 lg:gap-8">
        <RichText value={about.text} class="max-w-170 text-base leading-relaxed lg:text-[19px]" />
        <StatGrid stats={about.stats ?? []} />
      </div>
    </section>
  )}

  {quickLinks.length > 0 && (
    <nav aria-label="Quick links" class="px-5 py-5 lg:px-14 lg:py-10">
      <ul class="grid gap-0.5 lg:grid-cols-4">
        {quickLinks.map((link) => (
          <li>
            <a
              href={link.url}
              class="flex h-14 items-center justify-between bg-surface px-4 text-base font-black hover:bg-line lg:h-16 lg:px-5"
            >
              {link.label}
              <span class="text-esn-blue" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</Layout>
