---
import Layout from '../../layouts/Layout.astro'
import Picture from '../../components/Picture.astro'
import RichText from '../../components/RichText.astro'
import SectionContactCard from '../../components/SectionContactCard.astro'
import { fetchContent } from '../../lib/content'
import { SECTION_QUERY, SECTION_SLUGS_QUERY } from '../../lib/queries'
import { sectionColours } from '../../lib/section-colours'
import type { SectionDetail } from '../../lib/types'

export async function getStaticPaths() {
  const slugs = await fetchContent<string[]>(SECTION_SLUGS_QUERY)
  return slugs.map((slug) => ({ params: { slug } }))
}

const section = await fetchContent<SectionDetail | null>(SECTION_QUERY, {
  slug: Astro.params.slug,
})
if (!section) return new Response(null, { status: 404 })

const { colour, textClass, universityClass } = sectionColours(section.slug)
const hasCover = Boolean(section.coverImage?.asset)
const hasAbout = Boolean(section.about)
const hasContact = Boolean(section.email || section.socials?.instagram || section.socials?.website)
---

<Layout title={section.name} navAccent={colour}>
  <section
    style={`background: ${colour}`}
    class:list={['lg:grid', hasCover && 'lg:grid-cols-[7fr_5fr]', textClass]}
  >
    {hasCover && (
      <Picture
        image={section.coverImage}
        width={1280}
        height={800}
        eager
        class="aspect-16/10 w-full lg:col-start-2 lg:row-start-1 lg:aspect-auto lg:h-full lg:min-h-115"
      />
    )}
    <div class="flex flex-col gap-3.5 px-5 pt-6 pb-7 lg:justify-center lg:gap-5.5 lg:p-14">
      {section.university && (
        <p class="hidden text-[13px] font-black tracking-[.1em] uppercase lg:block">
          Sections / {section.university}
        </p>
      )}
      {/* No Section logo until we find a way to show it that follows the brand rules (docs/agents/brand-rules.md). */}
      <div class="flex flex-col gap-1 lg:gap-1.5">
        <h1 class="font-heading text-5xl leading-[.92] font-bold lg:text-[80px] lg:leading-[.9]">
          {section.name}
        </h1>
        {section.university && (
          <p data-section-university class={universityClass}>
            {section.university}
          </p>
        )}
      </div>
      {section.tagline && (
        <p
          data-section-tagline
          class="max-w-140 text-[19px] leading-[1.45] font-bold lg:text-[22px]"
        >
          {section.tagline}
        </p>
      )}
    </div>
  </section>

  {(hasAbout || hasContact) && (
    <div
      class:list={[
        'flex flex-col gap-7 px-5 py-7 lg:px-14 lg:py-16',
        hasContact && 'lg:grid lg:grid-cols-[minmax(0,1fr)_400px] lg:gap-16',
      ]}
    >
      {hasAbout && (
        <section class="flex flex-col gap-3 lg:gap-4">
          <div style={`background: ${colour}`} class="h-1.5 w-10 lg:h-2 lg:w-12" />
          <h2 class="font-heading text-3xl leading-none font-bold lg:text-[40px]">About us</h2>
          <RichText value={section.about} class="max-w-160 text-[17px] leading-[1.6] lg:text-xl" />
        </section>
      )}
      <SectionContactCard email={section.email} socials={section.socials} />
    </div>
  )}
</Layout>
