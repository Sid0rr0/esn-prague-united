---
import '../styles/global.css'
import Banner from '../components/Banner.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import ConsentBanner from '../components/ConsentBanner.astro'
import { fetchContent } from '../lib/content'
import { SETTINGS_QUERY } from '../lib/queries'
import { SITE_NAME } from '../lib/site'
import { imageUrl } from '../lib/image'
import type { Seo, Settings } from '../lib/types'

interface Props {
  title?: string
  seo?: Seo
  /** Colour of the active nav item's underline; the Events cyan by default. */
  navAccent?: string
}

const { title, seo, navAccent } = Astro.props
const settings = (await fetchContent<Settings | null>(SETTINGS_QUERY)) ?? {}
const pageTitle = seo?.title ?? title
// A page titled with the site name (e.g. /links) doesn't repeat it after the dot.
const fullTitle = pageTitle && pageTitle !== SITE_NAME ? `${pageTitle} · ${SITE_NAME}` : SITE_NAME
const description = seo?.description ?? settings.seo?.description
const shareImage = imageUrl(seo?.image ?? settings.seo?.image, { width: 1200, height: 630 })
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&display=swap"
    />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    {shareImage && <meta property="og:image" content={shareImage} />}
  </head>
  <body class="flex min-h-screen flex-col bg-white">
    {settings.announcement && <Banner {...settings.announcement} />}
    <Header logo={settings.logo} navigation={settings.navigation ?? []} accent={navAccent} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer text={settings.footerText} hasConsentLinks={settings.showsInstagram !== false} />
    <ConsentBanner />
  </body>
</html>
